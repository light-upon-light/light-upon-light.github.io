{"n": 1, "ar": "لَیْسَ الْخَبَرُ کَالْمُعَایَنَةِ"}
{"n": 2, "ar": "الْحَرْبُ خُدَعَةٌ"}
{"n": 3, "ar": "الْمُسْلِمُ مِرْآةُ الْمُسْلِمِ"}
{"n": 4, "ar": "الْمُسْتَشَارُ مُؤتَمَنٌ"}
{"n": 5, "ar": "الدَّالُّ عَلَی الْخَیْرِ کَفَاعِلِهِ"}
{"n": 6, "ar": "إِسْتَعِیْنُوْا عَلَی الْحَوَائِجِ بِالْکِتْمَانِ"}
{"n": 7, "ar": "إِتَّقُوْا النَّارَ وَلَوْ بِشِقِّ تَمْرَةٍ"}
{"n": 8, "ar": "الدُّنْیَا سِجْنُ الْمُؤمِنِ وَ جَنَّةُ الْکَافِرِ"}
{"n": 9, "ar": "الْحَیَاءُ خَیْرٌ کُلُّهُ"}
{"n": 10, "ar": "عِدَةُ الْمُؤمِنِ کَاَخْذِ الْکَفِّ"}
{"n": 11, "ar": "لَا یَحِلُّ لِمُؤمِنٍ اَنْ یَّجُهْرَ أخَاهُ فَوقَ ثَلَاثَةِ أیَّامٍ"}
{"n": 12, "ar": "لَیْسَ مِنَّا مَنْ غَشَّنَا"}
{"n": 13, "ar": "مَا قَلَّ وَكَفَى خَيْرٌ مِمَّا كَثُرَ وَأَلْهَى"}
{"n": 14, "ar": "الرَّاجِعُ فِيْ هِبَتِهِ کَالرَّاجِعِ فِيْ قَیْئِهِ"}
{"n": 15, "ar": "الْبَلَاءُ مُوَکِّلٌ بِالْمَنْطِقِ"}
{"n": 16, "ar": "النَّاسُ کَأسْنَانِ الْمُشْطِ"}
{"n": 17, "ar": "الْغِنَى غِنَى النَّفْسِ"}
{"n": 18, "ar": "الْسَّعِیْدُ مَنْ وُّعِظَ بِغَیْرِهِ"}
{"n": 19, "ar": "وَ إِنَّ مِنَ الشِّعْرِ لَحِکْمَةً وَاِنَّ مِنَ الْبَیَانِ لَسِحْرًا"}
{"n": 20, "ar": "عَفْوُ الْمُلُوْكِ إِبْقَاءٌ لِلْمُلْكِ"}
{"n": 21, "ar": "اَلْمَرْءُ مَعَ مَنْ أَحَبَّ"}
{"n": 22, "ar": "مَا هَلَكَ إمْرُؤٌ عَرَفَ قَدْرَهُ"}
{"n": 23, "ar": "اَلْوَلَدُ لِلْفِرَاشِ وَ لِلْعَاهِرِ الْحَجَرُ"}
{"n": 24, "ar": "الْیَدُ الْعُلْیَا خَیْرٌ مِّنَ الْیَدِ السُّفْلَی"}
{"n": 25, "ar": "لَا شَکَرَ اللهَ مَنْ لَّا یَشْکُرُ النَّاسَ"}
{"n": 26, "ar": "حُبُّكَ الشَّيْءَ یُعْمِيْ وَ یُصِمُّ"}
{"n": 27, "ar": "جُبِلَتِ الْقُلُوبُ عَلی حُبَّ مَنْ اَحْسَنَ اِلَیْهَا وَ بُغْضِ مَنْ اَسَاءَ اِلَیْهَا"}
{"n": 28, "ar": "الْتَّائِبُ مِنَ الذَّنْبِ کَمَنْ لَا ذَنْبَ لَهُ"}
{"n": 29, "ar": "الشَّاهِدُ یَرَی مَا لَا یَرَاهُ الْغَائِبُ"}
{"n": 30, "ar": "اِذا جَاءَکُمْ کَرِیْمُ قَوْمٍ فَاَکْرِمُوهُ"}
{"n": 31, "ar": "الْیَمِینُ الْفَاجِرَةُ تَدَعُ الدِّیَارَ الْبَلَاقِعَ"}
{"n": 32, "ar": "مَنْ قُتِلَ دُونَ مَالِهِ فَهُوَ شَهِیْدٌ"}
{"n": 33, "ar": "الْاَعْمَالُ بِالنِّیَّةِ"}
{"n": 34, "ar": "سَیِّدُ الْقَوْمِ خَادِمُهُمْ"}
{"n": 35, "ar": "خَیْرُ الْأُمُوْرِ أَوْسَطُهَا"}
{"n": 36, "ar": "اَللَّهُمَّ بَارِكْ فِیْ أُمَّتِیْ فِی بُکُوْرِهَا یَوْمَ الْخَمِیْسِ"}
{"n": 37, "ar": "کَادَ الْفَقْرُ أَنْ یَکُوْنَ کُفْرًا"}
{"n": 38, "ar": "الْسَّفَرُ قِطْعَةٌ مِّنَ الْعَذَابِ"}
{"n": 39, "ar": "خَیْرُ زَّادِ الْتَّقْوَی"}
{"n": 40, "ar": "الْمَجَالِسُ بِالْاَمَانَةِ"}
